APP_NAME="Beatriz & Kathy Cookies"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=beatriz_cookies
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_HTTP_ONLY=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@beatrizcookies.local"
MAIL_FROM_NAME="${APP_NAME}"

# Notificações de novos pedidos e mensagens (SMTP; não usa o mailer log).
# Outlook.com: prefira Área restrita > Configurações de e-mail (OAuth2).
# Padrão do painel: smtp-mail.outlook.com:587, STARTTLS,
# remetente rafael_hasoftware@outlook.com.br. Credenciais/tokens ficam criptografados no banco.
# APP_URL deve ser a URL pública HTTPS em produção e corresponder ao retorno cadastrado na Microsoft.
# As variáveis SMTP abaixo são usadas somente se não houver configuração salva no painel.
STORE_NOTIFICATIONS_TO=rafael_hasoftware@outlook.com.br
STORE_NOTIFICATIONS_MAILER=smtp
# Para envio real, substitua MAIL_HOST/PORT/USERNAME/PASSWORD pelos dados do provedor.
# MAIL_HOST=smtp.seu-provedor.example
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=remetente-autorizado@seu-dominio.example
# STARTTLS é obrigatório em smtp; para TLS implícito, use smtps e porta 465.
# A validação do certificado TLS permanece habilitada.
MAIL_TIMEOUT=20
# Mantenha QUEUE_CONNECTION=database e execute o worker e o scheduler (ver README).

# Primeiro administrador, somente no .env local. Deixe em branco neste exemplo.
# O seeder recusa produção e não altera senha nem perfil de uma conta existente.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
